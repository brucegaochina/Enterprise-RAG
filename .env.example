# Copy to .env and fill in. Without OPENAI_API_KEY the app runs in offline demo mode
# (local hashing embeddings + extractive answers) so it can be tried with zero setup.

OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (Azure OpenAI v1, DeepSeek, Groq, Ollama, LM Studio...)
# OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column; changing it requires `docker compose down -v`
EMBEDDING_DIM=1536

# Local PostgreSQL with pgvector (docker compose overrides this with its own db service)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
